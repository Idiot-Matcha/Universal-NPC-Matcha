local function workspaceFull()
    local ok, f = pcall(function() return Workspace:GetFullName() end)
    if ok and type(f) == "string" and #f > 0 then return f end
    return "game.Workspace"
end
local WS_FULL = workspaceFull()

-- Matcha instance wrappers are not reliably comparable (the same instance can
-- come back as two wrappers that fail ==), so every loop/watchdog carries a
-- plain-number generation and the handle registry is one shared table.
local function removeAllHandles()
    if type(_G.npcEspHandles) ~= "table" then
        _G.npcEspHandles = {}
        return
    end
    for _, rec in pairs(_G.npcEspHandles) do
        if type(rec) == "table" and rec.handle then
            pcall(rec.handle.Remove, rec.handle)
        end
    end
    for k in pairs(_G.npcEspHandles) do _G.npcEspHandles[k] = nil end
end

local function bumpGen()
    _G.npcEspGen = (tonumber(_G.npcEspGen) or 0) + 1
    return _G.npcEspGen
end

if type(_G.npcEspLoop) == "number" and tick() - _G.npcEspLoop < 10
    and not _G.npcEspDisabled then
    local myGen = bumpGen()
    _G.npcEspDisabled = true
    if type(_G.npcEspState) == "table" then
        _G.npcEspState.running = false
    end
    removeAllHandles()
    _G.npcEspLoop = nil
    if notify then
        notify("NPC ESP", "Disabled - rerun to enable", 3)
    end
    print("NPC ESP disabled")
    -- catch straggler registrations from a loop that was mid-scan
    task.spawn(function()
        task.wait(3)
        if _G.npcEspGen == myGen then removeAllHandles() end
    end)
    return
end

